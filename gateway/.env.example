# Copy to .env (or keep the team's .env one folder up) and run:
#   uv run --env-file .env uvicorn ominira.main:app --port 8080
# Never commit a real .env.

# SQLite on a laptop. Cloud SQL Postgres looks like
# postgresql+psycopg://USER:PASS@/ominira?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=sqlite:///./ominira.db

# claude uses Claude when ANTHROPIC_API_KEY is set; rules always uses the offline parser.
ASSISTANT=claude
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Seconds to wait for Claude before the rule parser answers instead.
CLAUDE_TIMEOUT_S=8

# Mock Zenith core: realistic | fast | flaky
ZENITH_PROFILE=realistic

# Confirm gate (kobo and seconds)
PAUSE_THRESHOLD_KOBO=5000000
DRAFT_LIFETIME_S=600
APPROVAL_LIFETIME_S=900
REQUERY_WAIT_S=3
# New-account name enquiries per customer (lookups, drafts and the assistant together)
LOOKUPS_PER_MINUTE=5
# PIN checks per token (unlock, confirm and protective settings together)
PIN_ATTEMPTS_PER_MINUTE=5
# Keys stored Idempotency-Key fingerprints. Random per process when empty.
IDEMPOTENCY_SECRET=

# Speech: elevenlabs | yarngpt. Without the chosen provider's key the app uses the phone's own voice.
SPEECH_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Or the account's data residency base, such as the EU one.
ELEVENLABS_BASE=https://api.elevenlabs.io
# The app's voice, and the live phone call's (where speed matters). Both read English, Yoruba and Hausa.
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_LIVE_MODEL=eleven_v4_turbo
ELEVENLABS_STT_MODEL=scribe_v2
# A voice id per language once a native speaker has picked it, e.g. en=<id>,pcm=<id>,yo=<id>,ha=<id>,ig=<id>
ELEVENLABS_VOICES=
# For any language without one above.
ELEVENLABS_DEFAULT_VOICE=JBFqnCBsd6RMkjVDRZzb
# true asks ElevenLabs to keep nothing (enable_logging=false). Enterprise plans only; others refuse it.
ELEVENLABS_ZERO_RETENTION=false

YARNGPT_API_KEY=
YARNGPT_BASE=https://api.yarngpt.ai
# Pin a voice per language once a native speaker has picked it, e.g. yo=idera,ha=umar,ig=chinenye
YARNGPT_VOICES=

# Rehearsal controls at /_mock/*. Set a token on any public deployment and send it as X-Mock-Admin.
MOCK_ADMIN=true
MOCK_ADMIN_TOKEN=
